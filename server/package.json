{
  "name": "fieldwork-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/index.ts",
    "migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/migrate.ts",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "1.7.11",
    "cors": "2.8.6",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.2"
  },
  "engines": { "node": ">=22.18" }
}
